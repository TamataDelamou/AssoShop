# Supabase / Base44 (auth native)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon

# Control Plane GSG (Kernel = super-admin / hub de tableaux de bord)
# SERVEUR UNIQUEMENT. Contrat complet : docs/CONTROL_PLANE.md
CONTROL_PLANE_ENABLED=0
CONTROL_PLANE_SERVICE_ID=assoshop
CONTROL_PLANE_INSTANCE_ID=assoshop-gn-dev
CONTROL_PLANE_KERNEL_ISSUER=gsg-kernel
CONTROL_PLANE_METRICS_URL=https://kernel.gsg.example/ingest/metrics
CONTROL_PLANE_AUDIT_URL=https://kernel.gsg.example/ingest/audit
# Jetons sortants : clé privée PEM (recommandé) OU secret partagé >= 32 caractères
# CONTROL_PLANE_OUTBOUND_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CONTROL_PLANE_OUTBOUND_SECRET=
# Jetons entrants du Kernel : clé publique PEM (recommandé) OU secret partagé >= 32 caractères
# CONTROL_PLANE_INBOUND_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CONTROL_PLANE_INBOUND_SECRET=
# mTLS (optionnel) : en-tête d'empreinte posé par la terminaison TLS + empreintes autorisées
# CONTROL_PLANE_MTLS_HEADER=x-client-cert-fingerprint
# CONTROL_PLANE_MTLS_FINGERPRINTS=
# Déclenchement planifié de /api/control-plane/push
CRON_SECRET=

# API métier Base44 (défaut : http://localhost:3000/api)
NEXT_PUBLIC_BASE44_API_URL=http://localhost:3000/api

# IA (assistant) — fournisseur OpenAI-compatible (OpenAI, Mistral, OpenRouter, ...)
# Sans AI_API_KEY, l'assistant retombe sur la synthèse locale déterministe.
AI_API_KEY=clé-ia
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1  # optionnel
