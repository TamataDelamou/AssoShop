# Supabase / Base44 (auth native)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon

# GSG Platform Kernel (optionnel, mocké par défaut)
NEXT_PUBLIC_KERNEL_API_URL=https://kernel.gsg.com/api
NEXT_PUBLIC_KERNEL_API_KEY=clé-kernel

# API métier Base44 (défaut : http://localhost:3000/api)
NEXT_PUBLIC_BASE44_API_URL=http://localhost:3000/api

# IA (assistant) — fournisseur OpenAI-compatible (OpenAI, Mistral, OpenRouter, ...)
# Sans AI_API_KEY, l'assistant retombe sur la synthèse locale déterministe.
AI_API_KEY=clé-ia
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1  # optionnel
